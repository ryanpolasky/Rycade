{
  "name": "rycade",
  "main": "src/worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/remote"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      },
      {
        "name": "SCORES",
        "class_name": "Scores"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Scores"]
    }
  ],
  "routes": [
    {
      "pattern": "arcade.ryanpolasky.com",
      "custom_domain": true
    }
  ],
  "env": {
    "preview": {
      "workers_dev": true,
      "routes": [],
      "durable_objects": {
        "bindings": [
          {
            "name": "ROOMS",
            "class_name": "Room"
          },
          {
            "name": "SCORES",
            "class_name": "Scores"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["Room"]
        },
        {
          "tag": "v2",
          "new_sqlite_classes": ["Scores"]
        }
      ]
    }
  }
}
